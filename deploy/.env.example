# ── RICtester 位址 ────────────────────────────────────────────────
# RICtester 是獨立於 IVT 的部署,同一台主機上跑著數套(依受測物種類分開),
# 各自一組 front-end / back-end / adapter / DB。
#
#   同機   → RIC_HOST=host.docker.internal(預設,不用設)
#   另一台 → RIC_HOST=<該主機 IP>
#
# 埠號對應該台各套 tester 的 .env(ADAPTER_PORT / BACK_END_PORT)。
RIC_HOST=host.docker.internal

# NearRICTester —— Lab Near-RT RIC(E2 / A1 / O1)
RIC_NEAR_ADAPTER_PORT=5100
RIC_NEAR_BACKEND_PORT=5000

# NonRICTester —— Lab Non-RT RIC(A1 / EI / SME / R1 / DME / AIML)
RIC_NON_ADAPTER_PORT=5110
RIC_NON_BACKEND_PORT=5010

# 環境攝影機 HLS(RICtester mediamtx)
RIC_HLS_PORT=8890

# postgres 密碼(不設則用 compose 預設 ivtpass)
# DB_PASSWORD=
