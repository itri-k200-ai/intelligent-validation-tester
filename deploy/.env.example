# ══ IVT 部署設定 ═══════════════════════════════════════════════════
# 這個檔不進版控(deploy/.env 被 gitignore),每台機器各自建一份。
# 兩個區塊:上半是「RICtester 在哪」,下半是「IVT 自己對外開哪些埠」。
# 全部有預設值 —— 跟 RICtester 不同機、且埠沒被佔的話,可以不建 .env。

# ── 1. RICtester 位址 ──────────────────────────────────────────────
# RICtester 獨立於 IVT 部署,同一台主機上跑著數套(依受測物種類分開),
# 各自一組 front-end / back-end / adapter / DB。
#
#   跟 IVT 同機 → RIC_HOST=host.docker.internal(預設,可省略)
#   在另一台   → RIC_HOST=<該主機 IP>
#
# 埠號對應該台各套 tester 的 .env(ADAPTER_PORT / BACK_END_PORT)。
RIC_HOST=host.docker.internal

# NearRICTester —— Lab Near-RT RIC(E2 / A1 / O1)
RIC_NEAR_ADAPTER_PORT=5100
RIC_NEAR_BACKEND_PORT=5000

# NonRICTester —— Lab Non-RT RIC(A1 / EI / SME / R1 / DME / AIML)
RIC_NON_ADAPTER_PORT=5110
RIC_NON_BACKEND_PORT=5010

# 環境攝影機 HLS(RICtester mediamtx)
RIC_HLS_PORT=8890

# ── 2. IVT 自己對外開的埠 ──────────────────────────────────────────
# 只有 nginx(唯一入口)一定要開,其餘都是 debug 用 —— 服務之間是走
# compose 內網以服務名互連,改這些埠不影響功能。
#
# ⚠ 跟 RICtester 同機部署時,3000 與 8001 會撞:
#     3000 ← NearRICTester 的 front_end
#     8001 ← nmagent 的 nm_backend
#   把下面兩行取消註解改掉即可。
# IVT_FRONTEND_PORT=3005
# IVT_BACKEND_WS_PORT=8011

IVT_NGINX_PORT=8080
# IVT_BACKEND_WEB_PORT=8002
# IVT_POSTGRES_PORT=5434
# IVT_REDIS_PORT=6379
# IVT_MINIO_PORT=9000
# IVT_MINIO_CONSOLE_PORT=9001
# IVT_MEDIAMTX_RTSP_PORT=8554
# IVT_MEDIAMTX_HLS_PORT=8888
# IVT_MEDIAMTX_API_PORT=9997

# ── 3. 其他 ────────────────────────────────────────────────────────
# postgres 密碼(不設則用 compose 預設 ivtpass)
# DB_PASSWORD=
