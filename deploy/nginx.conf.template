worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    keepalive_timeout 65;
    client_max_body_size 100m;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    upstream frontend      { server frontend:3000; }
    upstream backend_web   { server backend-web:8000; }
    upstream backend_ws    { server backend-ws:8001; }
    # RICtester —— 同一台主機上跑著數套彼此獨立的 tester(各自一組
    # front-end / back-end / adapter / DB),依受測物種類分開。位址由
    # deploy/.env 的 RIC_HOST / RIC_*_PORT 決定,容器啟動時由 nginx 官方
    # entrypoint 的 envsubst 代入(NGINX_ENVSUBST_FILTER=^RIC_ 只替換 RIC_*)。
    #
    #   near → NearRICTester(Lab Near-RT RIC:E2 / A1 / O1)
    #   non  → NonRICTester (Lab Non-RT RIC:A1 / EI / SME / R1 / DME / AIML)
    #
    # 前端 config/ricSources.ts 的 base 必須與下面的路徑前綴一致。
    upstream ric_near_adapter { server ${RIC_HOST}:${RIC_NEAR_ADAPTER_PORT}; }
    upstream ric_near_backend { server ${RIC_HOST}:${RIC_NEAR_BACKEND_PORT}; }
    upstream ric_non_adapter  { server ${RIC_HOST}:${RIC_NON_ADAPTER_PORT}; }
    upstream ric_non_backend  { server ${RIC_HOST}:${RIC_NON_BACKEND_PORT}; }
    # imctrl —— 在另一台主機(見 deploy/.env 的 RIC_IM_HOST),只有 adapter
    # 沒有 back_end。目前只給左螢幕的 API 工具手動打,牆面不吃它的資料
    # (見 frontend/src/config/ricSources.ts 的 onWall)。
    upstream ric_im_adapter   { server ${RIC_IM_HOST}:${RIC_IM_ADAPTER_PORT}; }
    # 環境影像 HLS —— 攝影機拆回 IVT 通用層,走 ivt-mediamtx(同 compose 網路內)
    upstream ivt_hls          { server mediamtx:8888; }

    # 單一入口。前端一份 image,靠 URL ?wall=left|center|right 切畫面。
    server {
        listen 80;
        # HTTPS —— 語音輸入(麥克風)只能在 HTTPS 下用,所以 /field 的小助理需要它。
        # 對外發布成 38443(見 docker-compose.yml),原本的 38080 HTTP 照常保留。
        #
        # 憑證是自簽的(deploy/certs/,不進版控),每台裝置第一次開會跳「不安全」警告,
        # 按「繼續前往」之後就能用。之後有網域與正式憑證,換掉這兩個檔案即可。重產:
        #   openssl req -x509 -newkey rsa:2048 -sha256 -nodes -days 825 \
        #     -keyout deploy/certs/ivt.key -out deploy/certs/ivt.crt -subj "/CN=60.250.213.44" \
        #     -addext "subjectAltName=IP:60.250.213.44,IP:10.194.87.120,IP:127.0.0.1,DNS:localhost" \
        #     -addext "extendedKeyUsage=serverAuth"
        listen 443 ssl;
        ssl_certificate     /etc/nginx/certs/ivt.crt;
        ssl_certificate_key /etc/nginx/certs/ivt.key;
        ssl_protocols       TLSv1.2 TLSv1.3;
        # HTTPS 走 HTTP/2:同一條連線多工,永不結束的 MJPEG 串流不會再把輪詢擠到排隊
        # (HTTP/1.1 每個來源只開 6 條連線 —— 中牆切換卡住就是這個)。
        # 只對 TLS 生效;瀏覽器在 80 上照樣講 HTTP/1.1。
        http2 on;
        server_name _;

        # ── RICtester 整合(電視牆資料來源)──
        # 每套 tester 一個路徑前綴 /ric/<來源>/,proxy_pass 後面帶 URI 會把
        # 前綴剝掉,所以上游收到的仍是原本的 /autoTest/* 與 /api/back_end/*。
        #
        # NearRICTester
        location /ric/near/autoTest/ {
            proxy_pass         http://ric_near_adapter/autoTest/;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
        }
        location /ric/near/api/back_end/ {
            proxy_pass         http://ric_near_backend/api/back_end/;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
        }
        # NonRICTester
        location /ric/non/autoTest/ {
            proxy_pass         http://ric_non_adapter/autoTest/;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
        }
        location /ric/non/api/back_end/ {
            proxy_pass         http://ric_non_backend/api/back_end/;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
        }
        # imctrl(只有 adapter)
        location /ric/im/autoTest/ {
            proxy_pass         http://ric_im_adapter/autoTest/;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
        }

        # 車載 MJPEG 影像 —— 長連線,要跟一般 API 分開設:
        #   proxy_buffering off   MJPEG 是一直流的 multipart,開 buffering 會
        #                         先攢一段才吐,牆上看起來卡頓且延遲
        #   read/send timeout     預設 60s 會在上游短暫停頓時切線;牆整天掛著,
        #                         這裡放長
        # (前綴比 /api/ 長,nginx 走最長前綴,會優先命中這條)
        location /api/field-tests/camera/ {
            proxy_pass         http://backend_web;
            proxy_http_version 1.1;
            proxy_buffering    off;
            proxy_read_timeout 24h;
            proxy_send_timeout 24h;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }

        # 小助理 → 網管 agent 的串流(SSE)。不能緩衝(不然整段答完才一次送到),
        # 也不能用預設 60 秒逾時(agent 一輪常超過一分鐘;中間有 15 秒一次的心跳)。
        location /api/assistant/ {
            proxy_pass         http://backend_web;
            proxy_http_version 1.1;
            proxy_buffering    off;
            proxy_read_timeout 10m;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }
        location /api/ {
            proxy_pass         http://backend_web;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }

        location /admin/ {
            proxy_pass         http://backend_web;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }

        location /static/ {
            proxy_pass         http://backend_web;
        }

        location /ws/ {
            proxy_pass         http://backend_ws;
            proxy_http_version 1.1;
            proxy_set_header   Upgrade           $http_upgrade;
            proxy_set_header   Connection        $connection_upgrade;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        # 環境攝影機 HLS —— IVT 通用層 mediamtx(去掉 /hls 前綴)
        location /hls/ {
            proxy_pass         http://ivt_hls/;
            proxy_set_header   Host              $host;
            # mediamtx 第一次請求會先 302 到 /<路徑>/index.m3u8?cookieCheck=1 —— 那是絕對路徑、
            # 沒有 /hls 前綴,不改寫的話瀏覽器會被轉到前端,拿到 Next 的 404 頁
            proxy_redirect     / /hls/;
            # 轉址維持相對路徑:絕對網址會用 nginx 容器內的埠(80 / 443),對外的 38080 / 38443 就不見了
            absolute_redirect  off;
            proxy_buffering    off;
            add_header         Cache-Control     no-cache;
        }

        location / {
            proxy_pass         http://frontend;
            proxy_http_version 1.1;
            proxy_set_header   Upgrade           $http_upgrade;
            proxy_set_header   Connection        $connection_upgrade;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }
    }
}
