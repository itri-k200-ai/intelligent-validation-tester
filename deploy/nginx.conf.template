worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    keepalive_timeout 65;
    client_max_body_size 100m;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    upstream frontend      { server frontend:3000; }
    upstream backend_web   { server backend-web:8000; }
    upstream backend_ws    { server backend-ws:8001; }
    # RICtester —— 同一台主機上跑著數套彼此獨立的 tester(各自一組
    # front-end / back-end / adapter / DB),依受測物種類分開。位址由
    # deploy/.env 的 RIC_HOST / RIC_*_PORT 決定,容器啟動時由 nginx 官方
    # entrypoint 的 envsubst 代入(NGINX_ENVSUBST_FILTER=^RIC_ 只替換 RIC_*)。
    #
    #   near → NearRICTester(Lab Near-RT RIC:E2 / A1 / O1)
    #   non  → NonRICTester (Lab Non-RT RIC:A1 / EI / SME / R1 / DME / AIML)
    #
    # 前端 config/ricSources.ts 的 base 必須與下面的路徑前綴一致。
    upstream ric_near_adapter { server ${RIC_HOST}:${RIC_NEAR_ADAPTER_PORT}; }
    upstream ric_near_backend { server ${RIC_HOST}:${RIC_NEAR_BACKEND_PORT}; }
    upstream ric_non_adapter  { server ${RIC_HOST}:${RIC_NON_ADAPTER_PORT}; }
    upstream ric_non_backend  { server ${RIC_HOST}:${RIC_NON_BACKEND_PORT}; }
    # 環境影像 HLS —— 攝影機拆回 IVT 通用層,走 ivt-mediamtx(同 compose 網路內)
    upstream ivt_hls          { server mediamtx:8888; }

    # 單一入口。前端一份 image,靠 URL ?wall=left|center|right 切畫面。
    server {
        listen 80;
        server_name _;

        # ── RICtester 整合(電視牆資料來源)──
        # 每套 tester 一個路徑前綴 /ric/<來源>/,proxy_pass 後面帶 URI 會把
        # 前綴剝掉,所以上游收到的仍是原本的 /autoTest/* 與 /api/back_end/*。
        #
        # NearRICTester
        location /ric/near/autoTest/ {
            proxy_pass         http://ric_near_adapter/autoTest/;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
        }
        location /ric/near/api/back_end/ {
            proxy_pass         http://ric_near_backend/api/back_end/;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
        }
        # NonRICTester
        location /ric/non/autoTest/ {
            proxy_pass         http://ric_non_adapter/autoTest/;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
        }
        location /ric/non/api/back_end/ {
            proxy_pass         http://ric_non_backend/api/back_end/;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
        }

        location /api/ {
            proxy_pass         http://backend_web;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }

        location /admin/ {
            proxy_pass         http://backend_web;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }

        location /static/ {
            proxy_pass         http://backend_web;
        }

        location /ws/ {
            proxy_pass         http://backend_ws;
            proxy_http_version 1.1;
            proxy_set_header   Upgrade           $http_upgrade;
            proxy_set_header   Connection        $connection_upgrade;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        # 環境攝影機 HLS —— IVT 通用層 mediamtx(去掉 /hls 前綴)
        location /hls/ {
            proxy_pass         http://ivt_hls/;
            proxy_set_header   Host              $host;
            add_header         Cache-Control     no-cache;
        }

        location / {
            proxy_pass         http://frontend;
            proxy_http_version 1.1;
            proxy_set_header   Upgrade           $http_upgrade;
            proxy_set_header   Connection        $connection_upgrade;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }
    }
}
