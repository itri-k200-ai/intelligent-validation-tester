# 全部走 IVT nginx(唯一入口 :8080)的同源相對路徑 —— 前端與 nginx 同一
# 主機時不用改。複製一份成 .env.local 即可:cp .env.example .env.local
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_API_BASE=/api
NEXT_PUBLIC_WS_BASE=/ws
NEXT_PUBLIC_MEDIA_BASE=/hls
NEXT_PUBLIC_APP_VERSION=1.0.0

# 想跑純前端(不需要 backend、用假資料)→ 改成 true。
# 注意:RICtester 的 adapter / back_end 沒有 mock 版本,牆上的測試資料
# 一律打真實來源(見 src/config/ricSources.ts),不受這個開關影響。
