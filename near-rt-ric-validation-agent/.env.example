# Copy to `.env` and fill in. `.env` is gitignored.

# === Required when exposing the app to the network ===

# Single-user login password. Leave empty to disable auth (local dev only).
# Any non-empty value enables the cookie-based login gate.
APP_PASSWORD=change-me

# Cookie signing secret. Rotate to invalidate every existing login.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string


# === Claude Code authentication (pick ONE) ===

# Option A: pay-as-you-go via your Anthropic API key.
#   ANTHROPIC_API_KEY=sk-ant-xxxx

# Option B: leave the API key empty and OAuth via your Claude subscription.
# After `docker-compose up -d --build`, run:
#     docker exec -it ${APP_SLUG}-backend claude auth login
# Click the URL it prints, sign in, paste the code back. Credentials
# persist in `.claude/.credentials.json` on the host.
ANTHROPIC_API_KEY=


# === Optional ===

# Pin Claude Code CLI version (default: latest). Bumps require backend rebuild.
# CLAUDE_CODE_VERSION=2.1.140

# Override the API origin seen by the browser. Leave empty to use same-origin
# (recommended; required for Cloudflare tunnel to work).
# NEXT_PUBLIC_API_BASE=
